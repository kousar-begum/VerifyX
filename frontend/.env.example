# ============================================================
# VerfiX AI - Frontend & Fullstack Environment Configuration
# ============================================================

# GEMINI_API_KEY: Required for Gemini AI API calls (if server-side AI logic is enabled)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# ------------------------------------------------------------
# VerfiX FastAPI Gateway
# ------------------------------------------------------------
# Host and port of your VerfiX FastAPI backend
VITE_API_BASE_URL="http://localhost:8000"
VITE_API_PREFIX="/api"

# ------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------
VITE_SUPABASE_URL="https://brbcjzxdkwysjdanxndh.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_hgVeqsvnBybZh0XMHdeswg_2lXK4j7J"

# Supabase Storage Buckets
VITE_DOCUMENTS_BUCKET="documents"
VITE_REPORTS_BUCKET="analysis-reports"
VITE_ARTIFACTS_BUCKET="analysis-artifacts"
VITE_PROCESSED_DOCUMENTS_BUCKET="processed-documents"

# ------------------------------------------------------------
# Risk Engine Thresholds
# ------------------------------------------------------------
VITE_LOW_RISK_MAX="29"
VITE_MEDIUM_RISK_MAX="59"
VITE_HIGH_RISK_MIN="60"

# File Upload Limits
VITE_MAX_UPLOAD_SIZE_MB="20"
